---
import { localizePath, useTranslations, type Lang } from "@/i18n/utils";
import { menuLinks, siteConfig } from "@/site-config";

interface Props {
	lang?: Lang;
}

const { lang = "en" } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const navLinks = menuLinks.map((link) => ({
	href: localizePath(link.path, lang),
	title: t.nav[link.key],
}));
---

<footer
	class="mt-auto flex w-full flex-col items-center justify-center gap-y-2 pb-4 pt-20 text-center align-top font-semibold text-gray-600 dark:text-gray-400 sm:flex-row sm:justify-between sm:text-xs"
>
	<div class="me-0 sm:me-4">
		&copy; {siteConfig.author}
		{year}.<span class="inline-block">&nbsp;🚀&nbsp;Astro Cactus</span>
	</div>
	<nav
		aria-label={t.footer.moreOnSite}
		class="flex gap-x-2 sm:gap-x-0 sm:divide-x sm:divide-gray-500"
	>
		{
			navLinks.map((link) => (
				<a class="px-4 py-2 sm:py-0 sm:hover:text-textColor sm:hover:underline" href={link.href}>
					{link.title}
				</a>
			))
		}
	</nav>
</footer>
