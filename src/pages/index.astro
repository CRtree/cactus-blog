---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const projects: { desc: string; href: string; title: string }[] = [
	{
		desc: "Sundial (晷) — a screen time app for iPhone to set app limits and build healthier phone habits.",
		href: "/sundial/",
		title: "Sundial",
	},
	{
		desc: "JetBrains IDE plugin that summarizes code changes and generates commit messages with a local LLM (Ollama).",
		href: "https://plugins.jetbrains.com/plugin/23820-code-changes-summarizer",
		title: "Code Changes Summarizer",
	},
	{
		desc: "JetBrains IDE plugin that analyzes application logs with AI to speed up issue identification and root cause analysis.",
		href: "https://plugins.jetbrains.com/plugin/25059-analysis-logs-with-ai",
		title: "Analysis Logs with AI",
	},
	{
		desc: "A native macOS app for managing shell environment variables across profiles, with JSON import and export.",
		href: "https://github.com/CRtree/EnvVarTool",
		title: "EnvVarTool",
	},
	{
		desc: "A Chrome extension that automatically saves and restores your reading position on long web pages.",
		href: "https://github.com/CRtree/web-bookmarks",
		title: "Scroll Saver",
	},
	{
		desc: "A small web app for string manipulation and text processing.",
		href: "https://github.com/CRtree/String-remove",
		title: "String Remove",
	},
];
---

<PageLayout meta={{ title: "Home" }}>
	<div data-pagefind-body>
		<section>
			<h1 class="title mb-6">Hello 👋</h1>
			<p class="mb-4">
				Welcome to my little corner of the internet. This is where I share the applications and tools I build.
			</p>
			<SocialList />
		</section>
		<section class="mt-16">
			<h2 class="title mb-4 text-xl">Build Applications</h2>
			<dl class="space-y-4">
				{
					projects.map(({ desc, href, title }) => {
						const isExternal = href.startsWith("http");
						return (
							<div class="flex flex-col gap-2 sm:flex-row">
								<dt>
									<span class="flex">
										<a
											class="cactus-link"
											href={href}
											rel={isExternal ? "noopener noreferrer" : undefined}
											target={isExternal ? "_blank" : undefined}
										>
											{title}
										</a>
										:
									</span>
								</dt>
								<dd>{desc}</dd>
							</div>
						);
					})
				}
			</dl>
		</section>
	</div>
</PageLayout>
